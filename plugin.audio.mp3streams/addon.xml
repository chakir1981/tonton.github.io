<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.audio.mp3streams" name="MP3 Streams" version="2019.09.30" provider-name="Bugatsinho">
    <requires>
        <import addon="xbmc.python" version="2.1.0" />
        <import addon="script.module.t0mm0.common" version="1.1.0" />
        <import addon="script.module.mutagen" version="1.41.1" />
        <import addon="script.module.requests" version="1.1.0" />
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>audio</provides>
    </extension>
    <extension point="xbmc.service" library="playerMP3.py" start="startup" />
    <extension point="xbmc.addon.metadata">
        <platform>all</platform>
        <summary>Une collection de musiques en streaming</summary>
        <description>Parcourez, écoutez ou téléchargez vos chansons et albums préférés</description>
        <news>Petites corrections / correction des jaquettes / page suivante
Remerciements à qahanik, kinkin pour le code d'origine et à Marquerite pour le graphisme</news>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
